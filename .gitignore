# ============================================================
# Terraform
# ============================================================

.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Terraform backend configuration
backend.hcl

# Terraform crash logs
crash.log
crash.*.log

# Variable files containing environment-specific values/secrets
*.tfvars
*.tfvars.json

# Allow safe example variable files
!*.tfvars.example

# Allow the fargate-dev image-tag file: not a secret, just a map of
# service -> ECR tag, and it MUST be tracked — it's the file
# app_Homeease's aws-ci.yml commits to, and the file
# terraform-aws-fargate-apply.yml applies. Without this exception the
# blanket *.tfvars rule above silently swallows it and the whole
# promotion mechanism has nothing to commit to.
!terraform/aws/environments/fargate-dev/image-tags.auto.tfvars

# ============================================================
# Secrets — real values, never examples
# ============================================================

.env
*.env
!.env.example
!*.env.example

# Local-only: state/tfvars archived from the expired subscription, and apply logs
_old-subscription-archive/
apply.log

# Merge leftovers
*.orig
*.rej
