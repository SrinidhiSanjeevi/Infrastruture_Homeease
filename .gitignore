# ============================================================
# Terraform
# ============================================================

.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Terraform backend configuration
backend.hcl

# Terraform crash logs
crash.log
crash.*.log

# Variable files containing environment-specific values/secrets
*.tfvars
*.tfvars.json

# Allow safe example variable files
!*.tfvars.example

# ============================================================
# Secrets — real values, never examples
# ============================================================

.env
*.env
!.env.example
!*.env.example